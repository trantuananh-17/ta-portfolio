# Domain công khai của site, dùng cho metadataBase / OG / sitemap.
# Chỉ đọc ở phía server nên set được lúc runtime; riêng sitemap.xml và
# robots.txt sinh ở build time nên Docker cần truyền vào cả bước build.
SITE_URL=https://portfolio.ragenta.cloud

# Contact form (Resend — https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Địa chỉ nhận mail liên hệ
CONTACT_TO_EMAIL=trantuananh.anhtt17@gmail.com

# Địa chỉ gửi đi. Để trống sẽ dùng onboarding@resend.dev (chỉ gửi được về
# email đã đăng ký Resend). Muốn gửi từ domain riêng thì verify domain trước.
CONTACT_FROM_EMAIL=onboarding@resend.dev
